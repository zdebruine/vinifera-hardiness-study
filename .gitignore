# Data — bulky immutable caches stay out (rebuildable; provenance in data/PROVENANCE.md);
# compact *sourced* outputs are committed so the repo stores the data we source.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
!data/interim/anchor_climate.csv
!data/interim/fps_catalog_raw.csv
!data/interim/fps_classified.csv
data/processed/*
!data/processed/.gitkeep
!data/processed/region_climate.csv
# vinifera.db is a rebuildable binary (scripts/build_db.py) — keep it out of git.
data/processed/vinifera.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Caches / tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
*.swp
